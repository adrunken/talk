# Ollama Configuration
# For local development: http://localhost:11434
# For Render deployment: https://ollama-ai-xxxx.onrender.com
OLLAMA_URL=http://localhost:11434

# GitHub Configuration (for publishing changes)
GITHUB_TOKEN=your_github_token_here
GITHUB_REPO=your_repo_owner/your_repo_name
GITHUB_BRANCH=main

# Server
PORT=12000
NODE_ENV=development
